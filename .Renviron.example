# Copy to .Renviron (git-ignored) and fill in. R reads it when it starts in the project root,
# and its values win over the shell's, so the board is chosen per command, not here:
#   CARDVAR_BOARD=r2 Rscript run_pipeline.R                  publish a release to R2
#   CARDVAR_BOARD=r2 Rscript -e 'shiny::runApp("app")'        browse the R2 releases
# Without CARDVAR_BOARD=r2, both use the local pins-local/ board.

# Publishing writes to R2, so this is the token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: the Object Read token, which deploy/deploy_connect.R gives the app instead.
# R2_READ_ACCESS_KEY_ID=
# R2_READ_SECRET_ACCESS_KEY=

# Optional (defaults shown)
# R2_PREFIX=card-variance/
# R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
